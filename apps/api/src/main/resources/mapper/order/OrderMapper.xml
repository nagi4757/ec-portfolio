<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nagi4757.ec.api.order.infra.mapper.OrderMapper">

    <resultMap id="orderResultMap" type="com.nagi4757.ec.api.order.infra.mapper.OrderRecord">
        <id     property="id"          column="id"/>
        <result property="userId"      column="user_id"/>
        <result property="status"      column="status"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="shippingRecipientName" column="shipping_recipient_name"/>
        <result property="shippingPostalCode"    column="shipping_postal_code"/>
        <result property="shippingPrefecture"    column="shipping_prefecture"/>
        <result property="shippingCity"          column="shipping_city"/>
        <result property="shippingAddressLine1"  column="shipping_address_line1"/>
        <result property="shippingAddressLine2"  column="shipping_address_line2"/>
        <result property="shippingPhoneNumber"   column="shipping_phone_number"/>
        <result property="createdAt"   column="created_at"/>
        <result property="updatedAt"   column="updated_at"/>
    </resultMap>

    <resultMap id="orderItemResultMap" type="com.nagi4757.ec.api.order.infra.mapper.OrderItemRecord">
        <id     property="id"         column="id"/>
        <result property="orderId"    column="order_id"/>
        <result property="productId"  column="product_id"/>
        <result property="name"       column="name"/>
        <result property="price"      column="price"/>
        <result property="quantity"   column="quantity"/>
        <result property="lineAmount" column="line_amount"/>
    </resultMap>

    <resultMap id="orderSummaryResultMap" type="com.nagi4757.ec.api.order.infra.mapper.OrderSummaryRecord">
        <id     property="id"          column="id"/>
        <result property="userId"      column="user_id"/>
        <result property="status"      column="status"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="createdAt"   column="created_at"/>
    </resultMap>

    <insert id="insertOrder" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO orders (
            user_id,
            status,
            total_amount,
            shipping_recipient_name,
            shipping_postal_code,
            shipping_prefecture,
            shipping_city,
            shipping_address_line1,
            shipping_address_line2,
            shipping_phone_number
        )
        VALUES (
            #{userId},
            #{status},
            #{totalAmount},
            #{shippingRecipientName},
            #{shippingPostalCode},
            #{shippingPrefecture},
            #{shippingCity},
            #{shippingAddressLine1},
            #{shippingAddressLine2},
            #{shippingPhoneNumber}
        )
    </insert>

    <insert id="insertOrderItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO order_items (order_id, product_id, name, price, quantity, line_amount)
        VALUES (#{orderId}, #{productId}, #{name}, #{price}, #{quantity}, #{lineAmount})
    </insert>

    <select id="selectOrderById" resultMap="orderResultMap">
        SELECT * FROM orders WHERE id = #{id}
    </select>

    <select id="selectOrderByIdAndUserId" resultMap="orderResultMap">
        SELECT * FROM orders WHERE id = #{id} AND user_id = #{userId}
    </select>

    <select id="selectOrdersByUserId" resultMap="orderResultMap">
        SELECT * FROM orders WHERE user_id = #{userId} ORDER BY id DESC
    </select>

    <select id="selectAllOrders" resultMap="orderResultMap">
        SELECT * FROM orders ORDER BY id DESC LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectOrderSummariesByUserId" resultMap="orderSummaryResultMap">
        SELECT id, user_id, status, total_amount, created_at
        FROM orders
        WHERE user_id = #{userId}
        ORDER BY id DESC
    </select>

    <select id="selectOrderSummaryPage" resultMap="orderSummaryResultMap">
        SELECT id, user_id, status, total_amount, created_at
        FROM orders
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countAllOrders" resultType="long">
        SELECT COUNT(*) FROM orders
    </select>

    <select id="selectItemsByOrderId" resultMap="orderItemResultMap">
        SELECT * FROM order_items WHERE order_id = #{orderId} ORDER BY id
    </select>

    <update id="updateOrderStatus">
        UPDATE orders
        SET status = #{targetStatus}
        WHERE id = #{id}
          AND status = #{expectedStatus}
        <if test="userId != null">
          AND user_id = #{userId}
        </if>
    </update>

</mapper>
