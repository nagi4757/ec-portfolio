[Unit]
Description=Renew the EC Portfolio Demo origin certificate
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
# Written by configure-acme.sh. No leading '-': a missing file must fail the
# unit rather than silently renew without backing the new certificate up.
EnvironmentFile=/etc/ec-portfolio/origin-tls.env
ExecStart=/usr/local/sbin/ec-portfolio-renew-origin-cert
TimeoutStartSec=20min
PrivateTmp=true
NoNewPrivileges=true
